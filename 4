import { useParams } from 'react-router-dom';
import { useFetchCourse } from '../../features/course/useCourse';
import LoadingPage from '../../pages/system/LoadingPage';
import ServerErrorPage from '../../pages/system/ServerErrorPage';
import { imageUrl } from '../../utils/imageUrl';
import HrWrapper from '../ui/HrWrapper';
import type { Chapter } from '../../types/FetchDataTypes';
import { ArrowSquareOutIcon } from '@phosphor-icons/react';
import { useState } from 'react';

const ViewCourse = () => {
  const { slug } = useParams();
  const { data, isLoading, isError } = useFetchCourse(slug);
  const [indexOpen, setIndexOpen] = useState<number | null>(null);
  const course = data?.courseDetails;
  console.log(data);

  if (isLoading) return <LoadingPage />;
  if (isError) return <ServerErrorPage />;
  return (
    <section id="course" className="gap-8">
      <div id="courseHeadline" className="bg-surface p-4">
        <h2>{course.title}</h2>
      </div>
      <div id="courseLeftPart" className="flex flex-col gap-8">
        <div id="courseTeacher" className="bg-surface p-4">
          <div className="topPart flex gap-5">
            <div className="avatar">
              {imageUrl(course?.creator?.avatarImage) ? (
                <img
                  src={imageUrl(course?.creator?.avatarImage)}
                  alt={course.creator.name.charAt(0)}
                  className="block w-20 h-20 object-cover object-center"
                />
              ) : (
                <p className="w-20 h-20 flex items-center justify-center">
                  {course?.creator?.name.split(' ')[0].charAt(0).toUpperCase()}
                  {course?.creator?.name.split(' ')[1].charAt(0).toUpperCase()}
                </p>
              )}
            </div>
            <div className="info flex flex-col justify-center relative overflow-x-hidden">
              <h4 className="min-w-0 truncate">{course.creator.name}</h4>
              <h5>{course.creator.username}</h5>
            </div>
            <div className="occupation ml-auto self-center bg-bg px-4 py-2 max-w-45 overflow-x-hidden">
              <h6 className="min-w-0 truncate">{course.creator.occupation}</h6>
            </div>
          </div>
          <HrWrapper name="⚜" />
          <div className="description">
            <p>{course.creator.description}</p>
          </div>
        </div>
        <div className="chapterInfo bg-surface p-4 flex flex-col gap-1">
          {course.chapters.map((chapter: Chapter, index: number) => (
            <div className="chapter" onClick={() => setIndexOpen(index)}>
              <div className="nameContainer bg-bg flex items-center justify-between overflow-x-hidden relative pr-9">
                <p className="no-margin p-2 truncate min-h-0">
                  Chapter {index + 1} :- {chapter.title}
                </p>
                <ArrowSquareOutIcon
                  weight="bold"
                  size={25}
                  className="absolute right-3 top-1/2 -translate-y-1/2"
                />
              </div>
              <div className="description text-wrap h-0">{chapter.description}</div>
            </div>
          ))}
        </div>
      </div>
      <div id="courseMiddlePart" className="bg-surface p-4"></div>
      <div id="courseRightPart" className="bg-surface p-4"></div>
    </section>
  );
};

export default ViewCourse;
